# ==============================================================================
# MediSense - Clinical Diabetes Decision Support System Configuration
# ==============================================================================

# Gemini AI API Key
# Used for synthesizing patient-specific risk prioritization reasoning & nurse call scripts
GEMINI_API_KEY=your_gemini_api_key_here

# Local SQLite Database Path (Default for local development)
SQLITE_DB_PATH=backend/medisense.db

# Optional Hosted Database (e.g. Turso / libSQL or PostgreSQL for cloud deployment)
# DATABASE_URL=postgresql://user:password@host:port/database
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Server & Client Ports and URLs
PORT=8000
VITE_API_URL=/api
